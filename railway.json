{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd troubleshoot-assistant && pip3 install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "python3 troubleshoot-assistant/app.py",
    "restartPolicyType": "ON_FAILURE"
  }
}
